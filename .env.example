# Pi-Switch environment variables (example).
# Copy to .env and fill in. Never commit real secrets.
# NEVER use VITE_* for secrets — VITE_* values are bundled into the renderer.

# Force Pi-Switch into mock mode during development (uses fixture Pi environment).
PI_SWITCH_MOCK=

# Optional: override the Pi CLI path used for detection (absolute path).
PI_SWITCH_PI_CLI_PATH=

# Optional: custom Pi config directory (defaults to ~/.pi/agent).
PI_SWITCH_PI_CONFIG_DIR=
