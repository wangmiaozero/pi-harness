{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi-Harness",
  "version": "1.6.0",
  "identifier": "dev.pi-harness.app",
  "build": {
    "beforeDevCommand": "pnpm tauri:web:dev",
    "devUrl": "http://localhost:31416",
    "beforeBuildCommand": "pnpm tauri:web:build",
    "frontendDist": "../out/renderer-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pi-Harness",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#17191C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
