{
  "name": "pi-harness",
  "version": "2.1.1",
  "description": "Operational Superset Harness and Desktop Control Plane for Pi Coding Agent",
  "productName": "Pi-Harness",
  "author": {
    "name": "wangmiao",
    "email": "tuziling84@gmail.com",
    "url": "https://github.com/wangmiaozero"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangmiaozero/pi-harness.git"
  },
  "homepage": "https://github.com/wangmiaozero/pi-harness",
  "bugs": {
    "url": "https://github.com/wangmiaozero/pi-harness/issues",
    "email": "tuziling84@gmail.com"
  },
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:nomascot": "electron-vite dev --mode nomascot",
    "compile": "pnpm check:builtin-skills && electron-vite build",
    "compile:nomascot": "pnpm check:builtin-skills && electron-vite build --mode nomascot",
    "build": "pnpm build:mac && pnpm build:win && pnpm build:linux",
    "build:mac": "pnpm compile && electron-builder --publish never --mac --arm64 && node scripts/clean-unpacked-mac.mjs",
    "build:mac:intel": "pnpm compile && electron-builder --publish never --mac --x64 && node scripts/clean-unpacked-mac.mjs",
    "build:mac:all": "pnpm compile && electron-builder --publish never --mac --arm64 --x64 && node scripts/clean-unpacked-mac.mjs",
    "build:win": "pnpm compile && electron-builder --publish never --win --x64",
    "build:linux": "pnpm compile && node scripts/electron-builder-linux.mjs",
    "build:nomascot": "pnpm build:mac:nomascot && pnpm build:win:nomascot && pnpm build:linux:nomascot",
    "build:mac:nomascot": "pnpm compile:nomascot && electron-builder --publish never --config electron-builder.nomascot.yml --mac --arm64 && node scripts/clean-unpacked-mac.mjs --nomascot",
    "build:mac:intel:nomascot": "pnpm compile:nomascot && electron-builder --publish never --config electron-builder.nomascot.yml --mac --x64 && node scripts/clean-unpacked-mac.mjs --nomascot",
    "build:mac:all:nomascot": "pnpm compile:nomascot && electron-builder --publish never --config electron-builder.nomascot.yml --mac --arm64 --x64 && node scripts/clean-unpacked-mac.mjs --nomascot",
    "build:win:nomascot": "pnpm compile:nomascot && electron-builder --publish never --config electron-builder.nomascot.yml --win --x64",
    "build:linux:nomascot": "pnpm compile:nomascot && node scripts/electron-builder-linux.mjs --nomascot",
    "build:release:mac-linux": "pnpm build:mac:all && pnpm build:linux && pnpm build:mac:all:nomascot && pnpm build:linux:nomascot",
    "build:release:win": "pnpm build:win && pnpm build:win:nomascot",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "quality": "node scripts/quality-gate.mjs",
    "quality:release": "node scripts/release-readiness.mjs",
    "benchmark:quality": "vitest run --config scripts/quality-benchmark.config.ts",
    "test:e2e": "pnpm compile && playwright test",
    "test:e2e:only": "playwright test",
    "sync:provider-presets": "node scripts/sync-provider-presets.mjs",
    "sync:builtin-skills": "node scripts/sync-builtin-skills.mjs",
    "check:builtin-skills": "node scripts/sync-builtin-skills.mjs --check",
    "clean": "rimraf out dist release .vite-node",
    "postinstall": "node node_modules/electron/install.js",
    "runtime:prepare": "node scripts/runtime/prepare-runtime.mjs",
    "runtime:verify": "node scripts/runtime/prepare-runtime.mjs --verify",
    "test:runtime": "node scripts/runtime/test-runtime.mjs",
    "release:package": "node scripts/release/native-package.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@comark/vue": "^0.7.0",
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@internationalized/date": "3.12.4",
    "@lezer/highlight": "^1.2.4",
    "@lucide/vue": "^1.48.0",
    "@tanstack/vue-query": "^5.103.2",
    "@xmldom/xmldom": "^0.8.11",
    "agent-aura": "^1.1.1",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "ignore": "7.0.10",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.5",
    "semver": "^7.8.5",
    "smol-toml": "1.9.1",
    "tar": "^7.5.22",
    "typebox": "1.3.27",
    "typescript": "^6.0.3",
    "unzipper": "0.12.5",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "electron": "^44.4.5",
    "electron-builder": "26.15.6",
    "electron-builder-squirrel-windows": "26.15.6",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "1.2.2"
    }
  }
}
