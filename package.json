{
  "name": "pi-harness",
  "version": "1.1.2",
  "description": "The Complete Desktop Harness for Pi Coding Agent",
  "productName": "Pi-Harness",
  "author": {
    "name": "wangmiao",
    "email": "tuziling84@gmail.com",
    "url": "https://github.com/wangmiaozero"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangmiaozero/pi-harness.git"
  },
  "homepage": "https://github.com/wangmiaozero/pi-harness",
  "bugs": {
    "url": "https://github.com/wangmiaozero/pi-harness/issues",
    "email": "tuziling84@gmail.com"
  },
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "dev": "electron-vite dev",
    "compile": "pnpm check:builtin-skills && electron-vite build",
    "build": "pnpm compile && electron-builder --mac --win --linux && node scripts/clean-unpacked-mac.mjs",
    "build:mac": "pnpm compile && electron-builder --mac --arm64 && node scripts/clean-unpacked-mac.mjs",
    "build:mac:intel": "pnpm compile && electron-builder --mac --x64 && node scripts/clean-unpacked-mac.mjs",
    "build:mac:all": "pnpm compile && electron-builder --mac --arm64 --x64 && node scripts/clean-unpacked-mac.mjs",
    "build:win": "pnpm compile && electron-builder --win",
    "build:linux": "pnpm compile && electron-builder --linux",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm compile && playwright test",
    "test:e2e:only": "playwright test",
    "sync:provider-presets": "node scripts/sync-provider-presets.mjs",
    "sync:builtin-skills": "node scripts/sync-builtin-skills.mjs",
    "check:builtin-skills": "node scripts/sync-builtin-skills.mjs --check",
    "clean": "rimraf out dist release .vite-node"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@comark/vue": "^0.6.2",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@lezer/highlight": "^1.2.3",
    "@lucide/vue": "^1.31.0",
    "@tanstack/vue-query": "^5.101.4",
    "@vueuse/core": "^14.4.0",
    "ai-motion": "0.4.8",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.6.2",
    "extract-zip": "^2.0.1",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.3",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
